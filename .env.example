# Copy this file to .env and adjust. Everything else is configured in the web UI.

# Port the web UI is published on (http://your-host:APP_PORT)
APP_PORT=8080

# Long random string; generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# Timezone used for reminder scheduling and due-date math
TZ=America/Toronto

# Postgres credentials (used by both the db container and the backend)
POSTGRES_DB=subscriptions
POSTGRES_USER=subscriptions
POSTGRES_PASSWORD=change-me

# Optional: create the admin user automatically on first start.
# If ADMIN_PASSWORD is empty, the web UI asks you to create the account on first visit.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Hosts allowed to reach the backend ("*" is fine behind the bundled nginx)
ALLOWED_HOSTS=*

# HTTPS reverse proxy (Traefik, Nginx Proxy Manager, Caddy...): works without extra settings as
# long as the proxy sends X-Forwarded-Proto (they all do by default). Recommended over HTTPS:
# COOKIE_SECURE=1
# Only if your proxy strips forwarded headers, list the public origin explicitly:
# CSRF_TRUSTED_ORIGINS=https://subs.example.com

# Published images, used by docker-compose.prod.yml (built by .github/workflows/ci.yml).
# IMAGE_PREFIX is ghcr.io/<github-user>/<repo>; images are <prefix>-backend and <prefix>-frontend.
# IMAGE_TAG can be latest, sha-<short commit>, sha-<full commit>, a branch name, or a version like 1.2.3.
IMAGE_PREFIX=ghcr.io/your-user/tallyfin
IMAGE_TAG=latest
