+
+/* ---------- subscriber page ---------- */
+.detail-head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; }
+.detail-id { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
+.detail-title-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
+.detail-name { font-family: var(--font-serif); font-size: 36px; line-height: 42px; font-weight: 600; letter-spacing: -0.01em; overflow-wrap: anywhere; }
+.detail-tags { display: flex; align-items: center; gap: 6px 10px; flex-wrap: wrap; }
+.detail-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
+
+.billing { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: 0; }
+.billing-fact { display: flex; flex-direction: column; gap: 4px; padding: 18px 24px; min-width: 0; }
+.billing-fact + .billing-fact { border-left: 1px solid var(--border); }
+.billing-value { font-size: 20px; line-height: 28px; font-weight: 600; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+.link-btn {
+  border: none; background: none; padding: 0; font: inherit; color: var(--foreground); cursor: pointer; text-align: left;
+  text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--input); width: fit-content;
+}
+.link-btn:hover { text-decoration-color: var(--foreground); }
+
+.detail-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 16px; align-items: start; }
+.advanced { margin-top: 14px; border-top: 1px solid var(--border); padding-top: 10px; font-size: 13px; }
+.advanced summary { cursor: pointer; color: var(--muted-foreground); width: fit-content; padding: 4px 0; }
+.advanced summary:hover { color: var(--foreground); }
+.advanced .kv { margin-top: 8px; }
+.detail-sticky { display: none; }
+
+@media (max-width: 1100px) {
+  .detail-grid { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-width: 900px) {
+  .billing { grid-template-columns: 1fr 1fr; }
+  .billing-fact { padding: 14px 16px; }
+  .billing-fact + .billing-fact { border-left: none; }
+  .billing-fact:nth-child(even) { border-left: 1px solid var(--border); }
+  .billing-fact:nth-child(n + 3) { border-top: 1px solid var(--border); }
+  .billing-value { font-size: 17px; line-height: 24px; }
+}
+@media (max-width: 720px) {
+  .detail-head { grid-template-columns: auto 1fr; }
+  .detail-actions { grid-column: 1 / -1; justify-content: stretch; }
+  .detail-actions .btn { flex: 1; }
+  .detail-name { font-size: 28px; line-height: 34px; }
+  /* Record payment moves to a bar above the tab bar, under the thumb. */
+  .detail-actions .detail-pay { display: none; }
+  .detail-sticky {
+    display: block; position: fixed; left: 0; right: 0; z-index: 15;
+    bottom: calc(var(--tabbar-height, 60px) + env(safe-area-inset-bottom));
+    padding: 10px 16px; background: color-mix(in oklch, var(--background) 92%, transparent);
+    backdrop-filter: blur(12px); border-top: 1px solid var(--border);
+  }
