+}
+
+/* ---------- payment list ---------- */
+.pay-list { list-style: none; margin: 0; padding: 0; }
+.pay-item { display: flex; align-items: center; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--border); }
+.pay-item:first-child { padding-top: 0; }
+.pay-item:last-child { border-bottom: none; padding-bottom: 0; }
+.pay-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
+.pay-line { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
+.pay-when, .pay-who { font-weight: 500; }
+.pay-who { text-decoration: none; }
+.pay-who:hover { text-decoration: underline; }
+.pay-amount { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.pay-meta { font-size: 12px; line-height: 16px; color: var(--muted-foreground); }
+.pay-note { font-size: 12px; line-height: 16px; color: var(--muted-foreground); font-style: italic; }
+
