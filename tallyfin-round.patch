+
+/* ---------- reading measure ---------- */
+/* ch is the width of "0", wider than an average letter: 60ch lands near 80 characters per line. */
+.help, .card-sub, .prose p, .confirm-body > p, .stack > p.text-muted, .row-between > p.text-muted { max-width: 60ch; }
