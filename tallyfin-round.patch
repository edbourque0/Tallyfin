+.paid-up { display: flex; align-items: center; gap: 16px; padding: 20px 4px 8px; }
+.paid-up svg { flex: none; }
+.paid-up-title { font-family: var(--font-serif); font-size: 22px; line-height: 28px; font-weight: 600; }
+
+/* ---------- sortable headers ---------- */
+th.sortable { padding: 0; }
+.th-sort {
